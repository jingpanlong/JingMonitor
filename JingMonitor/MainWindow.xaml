<Window x:Class="JingMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:JingMonitor" Title="景·速 Jing Monitor" Width="1200" Height="820" MinWidth="1050" MinHeight="720" WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush_0C1220}" WindowStyle="None" ResizeMode="CanResizeWithGrip">
 <Border BorderBrush="{DynamicResource Brush_2A3549}" BorderThickness="1" CornerRadius="12">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Brush_111A2A}" CornerRadius="12,0,0,12">
    <Grid Margin="20,24,16,18">
     <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
     <StackPanel><StackPanel Orientation="Horizontal"><local:BrandLogo Width="38" Height="38"/><StackPanel Margin="12,0,0,0"><TextBlock Text="景 · 速" FontSize="23" FontWeight="Bold"/><TextBlock Text="JING MONITOR" FontSize="9" Foreground="{DynamicResource Brush_7F93AB}" Margin="0,2,0,0"/></StackPanel></StackPanel><TextBlock Text="让每一刻，都心中有数。" Foreground="{DynamicResource Brush_74879F}" FontSize="11" Margin="0,18,0,0"/></StackPanel>
     <StackPanel Grid.Row="1" x:Name="Navigation">
      <TextBlock Text="工作空间" Foreground="{DynamicResource Brush_5F738D}" FontSize="10" Margin="12,0,0,14"/>
      <Button Content="◈    实时概览" Tag="overview" Click="Navigate" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="12,13"/>
      <Button Content="▦    硬件传感器" Tag="hardware" Click="Navigate" Margin="0,0,0,8" Padding="12,13"/>
      <Button Content="↗    流量统计" Tag="history" Click="Navigate" Margin="0,0,0,8" Padding="12,13"/>
      <Button Content="◑    皮肤工坊" Tag="skins" Click="Navigate" Margin="0,0,0,8" Padding="12,13"/>
      <TextBlock Text="偏好设置" Foreground="{DynamicResource Brush_5F738D}" FontSize="10" Margin="12,24,0,14"/>
      <Button Content="⚙    显示与提醒" Tag="settings" Click="Navigate" Margin="0,0,0,8" Padding="12,13"/>
      <Button Content="♡    关于与作者" Tag="about" Click="Navigate" Margin="0,0,0,8" Padding="12,13"/>
     </StackPanel>
     <Border Grid.Row="2" BorderBrush="{DynamicResource Brush_29374C}" BorderThickness="1" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="●  本地运行 · 保护隐私" Foreground="{DynamicResource Brush_5CE4C0}" FontSize="11"/><TextBlock Text="数据留在你的电脑上" Foreground="{DynamicResource Brush_74879F}" FontSize="10" Margin="0,8,0,0"/><TextBlock Text="v1.3.0  /  Windows x64" Foreground="{DynamicResource Brush_526781}" FontSize="10" Margin="0,8,0,0"/></StackPanel></Border>
    </Grid>
   </Border>
   <Grid Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
    <Grid Background="{DynamicResource Brush_0F1726}" MouseLeftButtonDown="DragTitle"><TextBlock Text="JING MONITOR  /  你的桌面性能伙伴" Foreground="{DynamicResource Brush_7588A2}" FontSize="11" Margin="28,0" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ThemeToggle" Content="☀ 浅色" Click="ToggleThemeClick" Margin="0,8,10,8" Padding="12,5"/><Button Content="─" Click="Minimize" Background="Transparent" Width="42" Margin="0"/><Button Content="□" Click="Maximize" Background="Transparent" Width="42" Margin="0"/><Button Content="×" Click="HideWindow" Background="Transparent" Width="46" Margin="0" FontSize="20"/></StackPanel></Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="30,24,30,20"><Grid Margin="0,0,0,24"><StackPanel><TextBlock x:Name="PageTitle" FontSize="27" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Foreground="{DynamicResource Brush_7C8FA8}" FontSize="12" Margin="0,9,0,0"/></StackPanel><Border Background="{DynamicResource Brush_152C2A}" CornerRadius="14" Padding="12,6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0"><TextBlock x:Name="LiveState" Text="●  正在连接" FontSize="11" Foreground="{DynamicResource Brush_5CE4C0}"/></Border></Grid><StackPanel x:Name="PageBody"/></StackPanel></ScrollViewer>
    <Grid Grid.Row="2" Margin="28,0"><TextBlock x:Name="Status" Text="正在读取系统信息…" FontSize="10" Foreground="{DynamicResource Brush_71839C}" VerticalAlignment="Center"/><TextBlock x:Name="Clock" FontSize="10" Foreground="{DynamicResource Brush_71839C}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
